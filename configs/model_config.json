{
  "model_info": {
    "name": "QoderFitness",
    "version": "2.1.0",
    "description": "Multi-task AI + Nano LLM: shared encoder + task-specific heads + decoder-only transformer. Train on TPU/GPU/CPU, infer on CPU client.",
    "author": "Qoder",
    "created": "2026-10-20",
    "framework": "PyTorch + NumPy",
    "license": "MIT"
  },
  "architecture": {
    "input_dim": 10,
    "shared_layers": [128, 128, 64],
    "shared_activation": "relu",
    "task_heads": {
      "A": { "output_dim": 3, "activation": "softmax", "loss": "cross_entropy", "weight": 1.0, "description": "3-class classification" },
      "B": { "output_dim": 2, "activation": "softmax", "loss": "cross_entropy", "weight": 1.0, "description": "2-class classification" },
      "C": { "output_dim": 1, "activation": "linear",  "loss": "mse",           "weight": 0.1, "description": "Regression (scalar)" },
      "D": { "output_dim": 5, "activation": "softmax", "loss": "cross_entropy", "weight": 1.0, "description": "5-class classification" }
    }
  },
  "llm": {
    "vocab_size": 256,
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "d_ff": 256,
    "max_seq": 128
  },
  "training": {
    "epochs": 2000,
    "learning_rate": 0.005,
    "batch_size": 512,
    "optimizer": "adam",
    "weight_decay": 1e-4,
    "lr_schedule": "cosine",
    "warmup_epochs": 20,
    "gradient_clip": 5.0,
    "gradient_accumulation_steps": 1,
    "early_stopping": { "patience": 80, "min_delta": 1e-4, "monitor": "score" },
    "seed": 2026,
    "mixed_precision": true,
    "device": "tpu",
    "num_workers": 4
  },
  "data": {
    "n_samples": 50000,
    "test_ratio": 0.1,
    "shuffle": true
  },
  "performance": {
    "num_threads": 8,
    "interop_threads": 4,
    "mkldnn": true,
    "deterministic": true
  },
  "inference": {
    "default_backend": "cpu",
    "default_input": [0.5, -1.2, 0.3, 1.0, 0.0, -0.4, 2.1, 0.7, -0.9, 1.3],
    "batch_inference": true
  },
  "paths": {
    "model_save": "models/qoderfitness_best.json",
    "encoder_save": "models/qoderfitness_encoder.json",
    "scaler_save": "models/x_scaler.npz",
    "log_dir": "logs",
    "tokenizer_save": "models/tokenizer.json",
    "llm_save": "models/llm.npz"
  }
}
